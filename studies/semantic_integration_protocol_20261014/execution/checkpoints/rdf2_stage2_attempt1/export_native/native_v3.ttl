@prefix i: <urn:rdf2:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

i:Mapping i:provider <urn:rdf2:provider/A>,
        <urn:rdf2:provider/B> ;
    i:version "3.0" .

<urn:rdf2:boundary/cold_reheat> a i:Boundary ;
    i:consumer <urn:rdf2:port/A/thermal.hrsg.reheat/inlet> ;
    i:identifier "cold_reheat" ;
    i:producer <urn:rdf2:port/B/cycle.expander/crossover_return> .

<urn:rdf2:boundary/condensate> a i:Boundary ;
    i:consumer <urn:rdf2:port/A/thermal.hrsg.water/inlet> ;
    i:identifier "condensate" ;
    i:producer <urn:rdf2:port/B/cycle.sink/liquid_exit> .

<urn:rdf2:boundary/gt_exhaust> a i:Boundary ;
    i:consumer <urn:rdf2:port/A/thermal.hrsg.gas/inlet> ;
    i:identifier "gt_exhaust" ;
    i:producer <urn:rdf2:port/A/thermal.gt/exh> .

<urn:rdf2:boundary/hot_reheat> a i:Boundary ;
    i:consumer <urn:rdf2:port/B/cycle.expander.ip/inlet> ;
    i:identifier "hot_reheat" ;
    i:producer <urn:rdf2:port/A/thermal.hrsg/rh_out> .

<urn:rdf2:boundary/hp_steam> a i:Boundary ;
    i:consumer <urn:rdf2:port/B/cycle.expander.hp/inlet> ;
    i:identifier "hp_steam" ;
    i:producer <urn:rdf2:port/A/thermal.hrsg/hp_out> .

<urn:rdf2:boundary/lp_steam> a i:Boundary ;
    i:consumer <urn:rdf2:port/B/cycle.expander.lp/inlet> ;
    i:identifier "lp_steam" ;
    i:producer <urn:rdf2:port/A/thermal.hrsg/lp_out> .

<urn:rdf2:boundary/st_exhaust> a i:Boundary ;
    i:consumer <urn:rdf2:port/B/cycle.sink.vapour/inlet> ;
    i:identifier "st_exhaust" ;
    i:producer <urn:rdf2:port/B/cycle.expander/tail_flow> .

<urn:rdf2:canonical/GasTurbine> a i:CanonicalClass ;
    rdfs:subClassOf <urn:rdf2:canonical/EngineeringAsset> ;
    i:identifier "GasTurbine" .

<urn:rdf2:canonical/HeatRecovery> a i:CanonicalClass ;
    rdfs:subClassOf <urn:rdf2:canonical/EngineeringAsset> ;
    i:identifier "HeatRecovery" .

<urn:rdf2:canonical/HeatSink> a i:CanonicalClass ;
    rdfs:subClassOf <urn:rdf2:canonical/EngineeringAsset> ;
    i:identifier "HeatSink" .

<urn:rdf2:canonical/SteamExpansion> a i:CanonicalClass ;
    rdfs:subClassOf <urn:rdf2:canonical/EngineeringAsset> ;
    i:identifier "SteamExpansion" .

<urn:rdf2:equipment/A/GT01> a i:Equipment ;
    i:equipmentClass <urn:rdf2:type/A/GasTurbine> ;
    i:identifier "GT01" .

<urn:rdf2:field/A/state/mass_rate> a i:Field ;
    i:identifier "mass_rate" ;
    i:mappedQuantity "mass_flow" ;
    i:mappedUnit "kg/s" ;
    i:quantity "mass_flow" ;
    i:unit "kg/s" .

<urn:rdf2:field/A/state/pressure_si> a i:Field ;
    i:identifier "pressure_si" ;
    i:mappedQuantity "pressure" ;
    i:mappedUnit "Pa" ;
    i:quantity "pressure" ;
    i:unit "Pa" .

<urn:rdf2:field/A/state/temperature_abs> a i:Field ;
    i:identifier "temperature_abs" ;
    i:mappedQuantity "temperature" ;
    i:mappedUnit "K" ;
    i:quantity "temperature" ;
    i:unit "K" .

<urn:rdf2:field/B/state/steam_pressure> a i:Field ;
    i:identifier "steam_pressure" ;
    i:mappedQuantity "pressure" ;
    i:mappedUnit "bar" ;
    i:quantity "pressure" ;
    i:unit "bar" .

<urn:rdf2:field/B/state/steam_temperature> a i:Field ;
    i:identifier "steam_temperature" ;
    i:mappedQuantity "temperature" ;
    i:mappedUnit "degC" ;
    i:quantity "temperature" ;
    i:unit "degC" .

<urn:rdf2:field/B/state/throughput_hourly> a i:Field ;
    i:identifier "throughput_hourly" ;
    i:mappedQuantity "mass_flow" ;
    i:mappedUnit "kg/h" ;
    i:quantity "mass_flow" ;
    i:unit "kg/h" .

<urn:rdf2:port/A/thermal.gt/exh> a i:Port ;
    i:direction "out" ;
    i:equipment <urn:rdf2:equipment/A/GT01> ;
    i:fieldset <urn:rdf2:fieldset/A/state> ;
    i:identifier "exh" ;
    i:namespace "thermal.gt" ;
    i:provider <urn:rdf2:provider/A> .

<urn:rdf2:port/A/thermal.hrsg.gas/inlet> a i:Port ;
    i:direction "in" ;
    i:equipment <urn:rdf2:equipment/A/H01> ;
    i:fieldset <urn:rdf2:fieldset/A/state> ;
    i:identifier "inlet" ;
    i:namespace "thermal.hrsg.gas" ;
    i:provider <urn:rdf2:provider/A> .

<urn:rdf2:port/A/thermal.hrsg.reheat/inlet> a i:Port ;
    i:direction "in" ;
    i:equipment <urn:rdf2:equipment/A/H01> ;
    i:fieldset <urn:rdf2:fieldset/A/state> ;
    i:identifier "inlet" ;
    i:namespace "thermal.hrsg.reheat" ;
    i:provider <urn:rdf2:provider/A> .

<urn:rdf2:port/A/thermal.hrsg.water/inlet> a i:Port ;
    i:direction "in" ;
    i:equipment <urn:rdf2:equipment/A/H01> ;
    i:fieldset <urn:rdf2:fieldset/A/state> ;
    i:identifier "inlet" ;
    i:namespace "thermal.hrsg.water" ;
    i:provider <urn:rdf2:provider/A> .

<urn:rdf2:port/A/thermal.hrsg/hp_out> a i:Port ;
    i:direction "out" ;
    i:equipment <urn:rdf2:equipment/A/H01> ;
    i:fieldset <urn:rdf2:fieldset/A/state> ;
    i:identifier "hp_out" ;
    i:namespace "thermal.hrsg" ;
    i:provider <urn:rdf2:provider/A> .

<urn:rdf2:port/A/thermal.hrsg/lp_out> a i:Port ;
    i:direction "out" ;
    i:equipment <urn:rdf2:equipment/A/H01> ;
    i:fieldset <urn:rdf2:fieldset/A/state> ;
    i:identifier "lp_out" ;
    i:namespace "thermal.hrsg" ;
    i:provider <urn:rdf2:provider/A> .

<urn:rdf2:port/A/thermal.hrsg/rh_out> a i:Port ;
    i:direction "out" ;
    i:equipment <urn:rdf2:equipment/A/H01> ;
    i:fieldset <urn:rdf2:fieldset/A/state> ;
    i:identifier "rh_out" ;
    i:namespace "thermal.hrsg" ;
    i:provider <urn:rdf2:provider/A> .

<urn:rdf2:port/B/cycle.expander.hp/inlet> a i:Port ;
    i:direction "in" ;
    i:equipment <urn:rdf2:equipment/B/ST1> ;
    i:fieldset <urn:rdf2:fieldset/B/state> ;
    i:identifier "inlet" ;
    i:namespace "cycle.expander.hp" ;
    i:provider <urn:rdf2:provider/B> .

<urn:rdf2:port/B/cycle.expander.ip/inlet> a i:Port ;
    i:direction "in" ;
    i:equipment <urn:rdf2:equipment/B/ST1> ;
    i:fieldset <urn:rdf2:fieldset/B/state> ;
    i:identifier "inlet" ;
    i:namespace "cycle.expander.ip" ;
    i:provider <urn:rdf2:provider/B> .

<urn:rdf2:port/B/cycle.expander.lp/inlet> a i:Port ;
    i:direction "in" ;
    i:equipment <urn:rdf2:equipment/B/ST1> ;
    i:fieldset <urn:rdf2:fieldset/B/state> ;
    i:identifier "inlet" ;
    i:namespace "cycle.expander.lp" ;
    i:provider <urn:rdf2:provider/B> .

<urn:rdf2:port/B/cycle.expander/crossover_return> a i:Port ;
    i:direction "out" ;
    i:equipment <urn:rdf2:equipment/B/ST1> ;
    i:fieldset <urn:rdf2:fieldset/B/state> ;
    i:identifier "crossover_return" ;
    i:namespace "cycle.expander" ;
    i:provider <urn:rdf2:provider/B> .

<urn:rdf2:port/B/cycle.expander/tail_flow> a i:Port ;
    i:direction "out" ;
    i:equipment <urn:rdf2:equipment/B/ST1> ;
    i:fieldset <urn:rdf2:fieldset/B/state> ;
    i:identifier "tail_flow" ;
    i:namespace "cycle.expander" ;
    i:provider <urn:rdf2:provider/B> .

<urn:rdf2:port/B/cycle.sink.vapour/inlet> a i:Port ;
    i:direction "in" ;
    i:equipment <urn:rdf2:equipment/B/CD1> ;
    i:fieldset <urn:rdf2:fieldset/B/state> ;
    i:identifier "inlet" ;
    i:namespace "cycle.sink.vapour" ;
    i:provider <urn:rdf2:provider/B> .

<urn:rdf2:port/B/cycle.sink/liquid_exit> a i:Port ;
    i:direction "out" ;
    i:equipment <urn:rdf2:equipment/B/CD1> ;
    i:fieldset <urn:rdf2:fieldset/B/state> ;
    i:identifier "liquid_exit" ;
    i:namespace "cycle.sink" ;
    i:provider <urn:rdf2:provider/B> .

<urn:rdf2:type/A/ControlledHRSG> a i:LocalClass ;
    rdfs:subClassOf <urn:rdf2:type/A/HRSG> ;
    i:identifier "ControlledHRSG" ;
    i:provider <urn:rdf2:provider/A> .

<urn:rdf2:type/A/GasTurbine> a i:LocalClass ;
    rdfs:subClassOf <urn:rdf2:type/A/PrimeMover> ;
    i:canonicalClass <urn:rdf2:canonical/GasTurbine> ;
    i:identifier "GasTurbine" ;
    i:provider <urn:rdf2:provider/A> .

<urn:rdf2:type/A/HRSG> a i:LocalClass ;
    rdfs:subClassOf <urn:rdf2:type/A/HeatRecoveryUnit> ;
    i:identifier "HRSG" ;
    i:provider <urn:rdf2:provider/A> .

<urn:rdf2:type/A/HeatRecoveryUnit> a i:LocalClass ;
    rdfs:subClassOf <urn:rdf2:type/A/ThermalAsset> ;
    i:canonicalClass <urn:rdf2:canonical/HeatRecovery> ;
    i:identifier "HeatRecoveryUnit" ;
    i:provider <urn:rdf2:provider/A> .

<urn:rdf2:type/A/PrimeMover> a i:LocalClass ;
    rdfs:subClassOf <urn:rdf2:type/A/ThermalAsset> ;
    i:identifier "PrimeMover" ;
    i:provider <urn:rdf2:provider/A> .

<urn:rdf2:type/B/ExpansionMachine> a i:LocalClass ;
    rdfs:subClassOf <urn:rdf2:type/B/CycleComponent> ;
    i:canonicalClass <urn:rdf2:canonical/SteamExpansion> ;
    i:identifier "ExpansionMachine" ;
    i:provider <urn:rdf2:provider/B> .

<urn:rdf2:type/B/HeatSink> a i:LocalClass ;
    rdfs:subClassOf <urn:rdf2:type/B/CycleComponent> ;
    i:canonicalClass <urn:rdf2:canonical/HeatSink> ;
    i:identifier "HeatSink" ;
    i:provider <urn:rdf2:provider/B> .

<urn:rdf2:type/B/ReheatSteamTurbine> a i:LocalClass ;
    rdfs:subClassOf <urn:rdf2:type/B/SteamTurbine> ;
    i:identifier "ReheatSteamTurbine" ;
    i:provider <urn:rdf2:provider/B> .

<urn:rdf2:type/B/SteamTurbine> a i:LocalClass ;
    rdfs:subClassOf <urn:rdf2:type/B/ExpansionMachine> ;
    i:identifier "SteamTurbine" ;
    i:provider <urn:rdf2:provider/B> .

<urn:rdf2:type/B/SurfaceCondenser> a i:LocalClass ;
    rdfs:subClassOf <urn:rdf2:type/B/HeatSink> ;
    i:identifier "SurfaceCondenser" ;
    i:provider <urn:rdf2:provider/B> .

<urn:rdf2:equipment/B/CD1> a i:Equipment ;
    i:equipmentClass <urn:rdf2:type/B/SurfaceCondenser> ;
    i:identifier "CD1" .

<urn:rdf2:type/A/ThermalAsset> a i:LocalClass ;
    rdfs:subClassOf i:Root ;
    i:canonicalClass <urn:rdf2:canonical/EngineeringAsset> ;
    i:identifier "ThermalAsset" ;
    i:provider <urn:rdf2:provider/A> .

<urn:rdf2:type/B/CycleComponent> a i:LocalClass ;
    rdfs:subClassOf i:Root ;
    i:canonicalClass <urn:rdf2:canonical/EngineeringAsset> ;
    i:identifier "CycleComponent" ;
    i:provider <urn:rdf2:provider/B> .

<urn:rdf2:equipment/B/ST1> a i:Equipment ;
    i:equipmentClass <urn:rdf2:type/B/ReheatSteamTurbine> ;
    i:identifier "ST1" .

<urn:rdf2:canonical/EngineeringAsset> a i:CanonicalClass ;
    rdfs:subClassOf i:Root ;
    i:identifier "EngineeringAsset" .

<urn:rdf2:equipment/A/H01> a i:Equipment ;
    i:equipmentClass <urn:rdf2:type/A/ControlledHRSG> ;
    i:identifier "H01" .

<urn:rdf2:fieldset/A/state> a i:FieldSet ;
    i:field <urn:rdf2:field/A/state/mass_rate>,
        <urn:rdf2:field/A/state/pressure_si>,
        <urn:rdf2:field/A/state/temperature_abs> .

<urn:rdf2:fieldset/B/state> a i:FieldSet ;
    i:field <urn:rdf2:field/B/state/steam_pressure>,
        <urn:rdf2:field/B/state/steam_temperature>,
        <urn:rdf2:field/B/state/throughput_hourly> .

<urn:rdf2:provider/A> a i:Provider ;
    i:identifier "A" ;
    i:requiredVersion "3.0" ;
    i:version "3.0" .

<urn:rdf2:provider/B> a i:Provider ;
    i:identifier "B" ;
    i:requiredVersion "3.0" ;
    i:version "3.0" .

