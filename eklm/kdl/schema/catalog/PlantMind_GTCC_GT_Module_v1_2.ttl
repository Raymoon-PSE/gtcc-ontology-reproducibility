pm:w_4_N2
    rdf:type pm:CompositionVariable ;
    pm:symbol "w" ; pm:var_unit_id "4" ; pm:subscript "N2" ;
    pm:var_value 0.0070 ; pm:var_unit "—" ; pm:var_role "composition" ;
    pm:layer_tag "Td" ;
