pm:w_4_C3H8
    rdf:type pm:CompositionVariable ;
    pm:symbol "w" ; pm:var_unit_id "4" ; pm:subscript "C3H8" ;
    pm:var_value 0.0105 ; pm:var_unit "—" ; pm:var_role "composition" ;
    pm:layer_tag "Td" ;
    rdfs:label "w^(4)_C3H8: C3H8 mass fraction in fuel inlet"@en .

pm:w_4_C4H10
    rdf:type pm:CompositionVariable ;
    pm:symbol "w" ; pm:var_unit_id "4" ; pm:subscript "C4H10" ;
    pm:var_value 0.0038 ; pm:var_unit "—" ; pm:var_role "composition" ;
    pm:layer_tag "Td" ;
