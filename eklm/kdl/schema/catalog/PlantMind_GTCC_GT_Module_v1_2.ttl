pm:w_4_CO2
    rdf:type pm:CompositionVariable ;
    pm:symbol "w" ; pm:var_unit_id "4" ; pm:subscript "CO2" ;
    pm:var_value 0.0213 ; pm:var_unit "—" ; pm:var_role "composition" ;
