pm:Stream-4  pm:has_composition pm:w_4_CH4 ;
             pm:has_composition pm:w_4_C2H6 ;
             pm:has_composition pm:w_4_C3H8 ;
             pm:has_composition pm:w_4_C4H10 ;
             pm:has_composition pm:w_4_N2 ;
             pm:has_composition pm:w_4_CO2 .


# ── 3.4 Variable Individuals (unit-local) ──────────────────

# Compressor parameters (Ta layer — back-calculated from NETL)
pm:eta_comp
    rdf:type pm:ModelParameter ;
    pm:symbol "eta" ; pm:var_unit_id "comp" ; pm:subscript "" ;
    pm:var_unit "—" ; pm:var_role "parameter" ;
    pm:layer_tag "Ta" ;
    pm:user_override true ;
    rdfs:label "eta^(comp): Compressor isentropic efficiency"@en ;
    rdfs:comment "Back-calculated from NETL. Open Issue #10."@en .

pm:PR_comp
    rdf:type pm:ModelParameter ;
    pm:symbol "PR" ; pm:var_unit_id "comp" ; pm:subscript "" ;
    pm:var_unit "—" ; pm:var_role "parameter" ;
    pm:layer_tag "Ta" ;
    pm:user_override true ;
    rdfs:label "PR^(comp): Compressor pressure ratio"@en ;
    rdfs:comment "Back-calculated from NETL. Open Issue #10."@en .

pm:f_bleed
    rdf:type pm:ModelParameter ;
    pm:symbol "f" ; pm:var_unit_id "bleed" ; pm:subscript "" ;
    pm:var_value 0.0 ; pm:default_value 0.0 ;
    pm:var_unit "—" ; pm:var_role "parameter" ;
    pm:layer_tag "Td" ;
    pm:user_override true ;
    rdfs:label "f_bleed: Bleed air fraction"@en ;
    rdfs:comment "Default 0 (Phase 1). Structure ready for Phase 2."@en .

pm:W_dot_comp
    rdf:type pm:ComputedScalar ;
    pm:symbol "W_dot" ; pm:var_unit_id "comp" ; pm:subscript "" ;
    pm:var_unit "kW" ; pm:var_role "computed" ;
    pm:layer_tag "Td" ;
    rdfs:label "W_dot^(comp): Compressor power"@en .

# Combustor parameters
pm:eta_comb
    rdf:type pm:ModelParameter ;
    pm:symbol "eta" ; pm:var_unit_id "comb" ; pm:subscript "" ;
    pm:var_value 0.998 ; pm:default_value 0.998 ;
    pm:var_unit "—" ; pm:var_role "parameter" ;
    pm:layer_tag "Td" ;
    pm:user_override true ;
    rdfs:label "eta^(comb): Combustor thermal efficiency"@en .

pm:delta_comb
    rdf:type pm:ModelParameter ;
    pm:symbol "delta" ; pm:var_unit_id "comb" ; pm:subscript "" ;
    pm:var_value 0.03 ; pm:default_value 0.03 ;
    pm:var_unit "—" ; pm:var_role "parameter" ;
    pm:layer_tag "Td" ;
    pm:user_override true ;
    rdfs:label "delta^(comb): Combustor pressure drop fraction"@en .

pm:Q_dot_comb
    rdf:type pm:ComputedScalar ;
    pm:symbol "Q_dot" ; pm:var_unit_id "comb" ; pm:subscript "" ;
    pm:var_unit "kJ/hr" ; pm:var_role "computed" ;
    pm:layer_tag "Td" ;
    rdfs:label "Q_dot^(comb): Combustor heat release rate"@en .

pm:AFR
    rdf:type pm:ComputedScalar ;
    pm:symbol "AFR" ; pm:var_unit_id "comb" ; pm:subscript "" ;
    pm:var_unit "—" ; pm:var_role "computed" ;
    pm:layer_tag "Td" ;
    rdfs:label "AFR: Air-fuel ratio (mass basis)"@en .

pm:lambda
    rdf:type pm:ComputedScalar ;
    pm:symbol "lambda" ; pm:var_unit_id "comb" ; pm:subscript "" ;
    pm:var_unit "—" ; pm:var_role "computed" ;
    pm:layer_tag "Td" ;
    rdfs:label "lambda: Excess air ratio"@en .

pm:NOx_ppm
    rdf:type pm:ComputedScalar ;
    pm:symbol "NOx" ; pm:var_unit_id "comb" ; pm:subscript "ppm" ;
    pm:var_unit "ppm" ; pm:var_role "computed" ;
    pm:layer_tag "Td" ;
    rdfs:label "NOx_ppm: NOx emission (empirical correlation)"@en ;
    rdfs:comment "Open Issue #11: correlation constants alpha, beta for H2/NH3 blends needed."@en .

# GT Expander parameters (Ta layer)
pm:eta_turb
    rdf:type pm:ModelParameter ;
    pm:symbol "eta" ; pm:var_unit_id "turb" ; pm:subscript "" ;
    pm:var_unit "—" ; pm:var_role "parameter" ;
    pm:layer_tag "Ta" ;
    pm:user_override true ;
    rdfs:label "eta^(turb): GT Expander isentropic efficiency"@en ;
    rdfs:comment "Back-calculated from NETL. Open Issue #10."@en .

pm:W_dot_turb
    rdf:type pm:ComputedScalar ;
    pm:symbol "W_dot" ; pm:var_unit_id "turb" ; pm:subscript "" ;
    pm:var_unit "kW" ; pm:var_role "computed" ;
    pm:layer_tag "Td" ;
    rdfs:label "W_dot^(turb): GT Expander power output"@en .

# GT Generator parameters
pm:eta_gen
    rdf:type pm:ModelParameter ;
    pm:symbol "eta" ; pm:var_unit_id "gen" ; pm:subscript "" ;
    pm:var_value 0.984 ; pm:default_value 0.984 ;
    pm:var_unit "—" ; pm:var_role "parameter" ;
    pm:layer_tag "Td" ;
    pm:user_override true ;
    rdfs:label "eta^(gen): GT Generator efficiency"@en ;
    rdfs:comment "Independent of eta^(stgen). Both default 0.984 per NETL."@en .

pm:W_dot_shaft
    rdf:type pm:ComputedScalar ;
    pm:symbol "W_dot" ; pm:var_unit_id "shaft" ; pm:subscript "" ;
    pm:var_unit "kW" ; pm:var_role "computed" ;
    pm:layer_tag "Td" ;
    rdfs:label "W_dot^(shaft): GT Net shaft power"@en ;
    rdfs:comment "= W_dot^(turb) - W_dot^(comp). NETL: 368,089 kW."@en .

pm:W_dot_GT
    rdf:type pm:ComputedScalar ;
    pm:symbol "W_dot" ; pm:var_unit_id "GT" ; pm:subscript "" ;
    pm:var_unit "kW" ; pm:var_role "computed" ;
    pm:layer_tag "Td" ;
    rdfs:label "W_dot^(GT): GT Gross electrical power"@en ;
    rdfs:comment "= eta^(gen) × W_dot^(shaft). NETL: 362,200 kWe."@en .

# Equipment → Variable links (has_parameter)
pm:COMP-001  pm:has_parameter pm:eta_comp ;
             pm:has_parameter pm:PR_comp ;
             pm:has_parameter pm:f_bleed ;
             pm:has_parameter pm:W_dot_comp .

pm:COMB-001  pm:has_parameter pm:eta_comb ;
             pm:has_parameter pm:delta_comb ;
             pm:has_parameter pm:Q_dot_comb ;
             pm:has_parameter pm:AFR ;
             pm:has_parameter pm:lambda ;
             pm:has_parameter pm:NOx_ppm .

pm:EXP-001   pm:has_parameter pm:eta_turb ;
             pm:has_parameter pm:W_dot_turb .

pm:GEN-001   pm:has_parameter pm:eta_gen ;
             pm:has_parameter pm:W_dot_shaft ;
             pm:has_parameter pm:W_dot_GT .

# has_heat_duty, has_work_output
pm:COMB-001  pm:has_heat_duty  pm:Q_dot_comb .
pm:EXP-001   pm:has_work_output pm:W_dot_turb .
pm:COMP-001  pm:has_work_output pm:W_dot_comp .
pm:GEN-001   pm:has_work_output pm:W_dot_GT .


# ── 3.5 KPI Individuals ────────────────────────────────────

pm:KPI-gt_power
    rdf:type pm:KPI ;
    pm:kpi_name "gt_power" ; pm:kpi_unit "kWe" ;
    pm:kpi_target 362200.0 ; pm:kpi_tolerance 0.05 ;
    pm:kpi_status "not_computed" ;
    pm:layer_tag "Td" ;
    rdfs:label "KPI: GT Gross Power"@en .

pm:KPI-net_power
    rdf:type pm:KPI ;
    pm:kpi_name "net_power" ; pm:kpi_unit "kWe" ;
    pm:kpi_target 555080.0 ; pm:kpi_tolerance 0.05 ;
    pm:kpi_status "not_computed" ;
    pm:layer_tag "Td" ;
    rdfs:label "KPI: Net Plant Power"@en .

pm:KPI-net_efficiency_HHV
    rdf:type pm:KPI ;
    pm:kpi_name "net_efficiency_HHV" ; pm:kpi_unit "—" ;
    pm:kpi_target 0.502 ; pm:kpi_tolerance 0.01 ;
    pm:kpi_status "not_computed" ;
    pm:layer_tag "Td" ;
    rdfs:label "KPI: Net Plant Efficiency (HHV)"@en .

pm:KPI-exhaust_T
    rdf:type pm:KPI ;
    pm:kpi_name "gt_exhaust_T" ; pm:kpi_unit "°C" ;
    pm:kpi_target 629.0 ; pm:kpi_tolerance 5.0 ;
    pm:kpi_status "not_computed" ;
    pm:layer_tag "Td" ;
    rdfs:label "KPI: GT Exhaust Temperature"@en .

pm:KPI-TIT
    rdf:type pm:KPI ;
    pm:kpi_name "TIT" ; pm:kpi_unit "°C" ;
    pm:kpi_target 1371.0 ; pm:kpi_tolerance 10.0 ;
    pm:kpi_status "not_computed" ;
    pm:layer_tag "Td" ;
    rdfs:label "KPI: Turbine Inlet Temperature"@en .

# computes_kpi links
pm:GEN-001   pm:computes_kpi pm:KPI-gt_power .
pm:EXP-001   pm:computes_kpi pm:KPI-exhaust_T .
pm:COMB-001  pm:computes_kpi pm:KPI-TIT .
pm:GT-001    pm:computes_kpi pm:KPI-gt_power ;
             pm:computes_kpi pm:KPI-net_power ;
             pm:computes_kpi pm:KPI-net_efficiency_HHV .


# ── 3.6 affects Chain (Rcausal) ────────────────────────────
# Principle: Stream nodes participate directly.
# TIT = Stream-6.T, referenced via Stream-6.

# Parameter → Stream level (Ta/Td)
pm:eta_comp   pm:affects pm:Stream-3 .
pm:PR_comp    pm:affects pm:Stream-3 .
pm:Stream-3   pm:affects pm:Stream-6 .       # compressed air → combustion T
pm:eta_comb   pm:affects pm:Stream-6 .
pm:delta_comb pm:affects pm:Stream-6 .
pm:Stream-6   pm:affects pm:W_dot_turb .     # TIT → turbine power
pm:Stream-6   pm:affects pm:KPI-TIT .
pm:eta_turb   pm:affects pm:W_dot_turb .
pm:W_dot_turb pm:affects pm:W_dot_shaft .
pm:W_dot_comp pm:affects pm:W_dot_shaft .
pm:W_dot_shaft pm:affects pm:W_dot_GT .
pm:eta_gen    pm:affects pm:W_dot_GT .
pm:W_dot_GT   pm:affects pm:KPI-gt_power .
pm:KPI-gt_power pm:affects pm:KPI-net_power .
pm:KPI-net_power pm:affects pm:KPI-net_efficiency_HHV .

# Stream-7 in causal chain (for HRSG and stack)
pm:Stream-6   pm:affects pm:Stream-7 .       # combustion T → exhaust T
pm:Stream-7   pm:affects pm:KPI-exhaust_T .


# ── 3.7 DesignRationale Individuals ───────────────────────

pm:DR-M1-001
    rdf:type pm:DesignRationale ;
    pm:decision_id    "DR-M1-001" ;
    pm:decision_text  "Bleed air treatment" ;
    pm:selected       "f_bleed=0 (Phase 1 only)" ;
    pm:alternatives   "Explicit bleed fraction with separate stream" ;
    pm:rationale      "NETL does not separate bleed flow. Phase 1 simplified for PoC. Structure reserved for Phase 2." ;
    pm:source         "Session 5, 2026-04-01" ;
    pm:decision_date  "2026-04-01" ;
    rdfs:label        "DR-M1-001: Bleed air treatment"@en .

pm:DR-M1-002
    rdf:type pm:DesignRationale ;
    pm:decision_id    "DR-M1-002" ;
    pm:decision_text  "Combustor operating mode default" ;
    pm:selected       "Mode A: fuel flow given, TIT calculated" ;
    pm:alternatives   "Mode B: TIT given, fuel flow calculated" ;
    pm:rationale      "Mode A is more general. NETL uses Mode B only for validation. Both modes explicitly supported." ;
    pm:source         "Session 5, 2026-04-01" ;
    pm:decision_date  "2026-04-01" ;
    rdfs:label        "DR-M1-002: Combustor operating mode"@en .

pm:DR-M1-003
    rdf:type pm:DesignRationale ;
    pm:decision_id    "DR-M1-003" ;
    pm:decision_text  "Humidity treatment in air stream" ;
    pm:selected       "Included in w^(1) as-is from NETL" ;
    pm:alternatives   "Separate psychrometric calculation" ;
    pm:rationale      "NETL provides combined composition including H2O. No separate psychrometric calc needed for Phase 1." ;
    pm:source         "Session 5, 2026-04-01" ;
    pm:decision_date  "2026-04-01" ;
    rdfs:label        "DR-M1-003: Humidity treatment"@en .

pm:DR-M1-004
    rdf:type pm:DesignRationale ;
    pm:decision_id    "DR-M1-004" ;
    pm:decision_text  "GT exhaust duct as separate unit" ;
    pm:selected       "No separate exhaust duct unit" ;
    pm:alternatives   "Unit 1-7 Exhaust Duct with explicit pressure drop" ;
    pm:rationale      "Simple pressure drop not warranted as separate unit in Phase 1. dP included in EXP-001 outlet pressure." ;
    pm:source         "Session 5, 2026-04-01" ;
    pm:decision_date  "2026-04-01" ;
    rdfs:label        "DR-M1-004: Exhaust duct treatment"@en .

pm:DR-M1-005
    rdf:type pm:DesignRationale ;
    pm:decision_id    "DR-M1-005" ;
    pm:decision_text  "NOx model selection" ;
    pm:selected       "Option C: fuel-blend correlation NOx = NOx_NG(1 + alpha*x_H2 + beta*x_NH3)" ;
    pm:alternatives   "Option A: constant; Option B: TIT correlation only" ;
    pm:rationale      "C17 requires fuel-dependent NOx comparison across H2/NH3 blends." ;
    pm:source         "Session 5, 2026-04-01" ;
    pm:decision_date  "2026-04-01" ;
    rdfs:label        "DR-M1-005: NOx model"@en .

pm:DR-M1-006
    rdf:type pm:DesignRationale ;
