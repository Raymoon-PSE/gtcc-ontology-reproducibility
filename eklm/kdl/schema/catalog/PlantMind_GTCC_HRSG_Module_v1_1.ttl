# --- Node 2-4M: IP Mixing Node ---
pm:IPMX-001
    rdf:type pm:ProcessUnit ;
    rdfs:label "IP Mixing Node 2-4M"@en ;
    rdfs:comment "Adiabatic mixing of S24 (reheated cold reheat) + IS-04 (IP steam) → IS-03 (hot reheat). Calculated after Unit 2-5."@en ;
    pm:tag         "IPMX-001" ;
    pm:unit_id     "2-4M" ;
    pm:module_id   "M2" ;
    pm:vendor_flag false ;
    pm:calc_order  "4M" ;
    pm:pattern     "MIXING" ;
    pm:part_of     pm:HRSG-M2-001 ;
    pm:has_inlet_stream  pm:S24 ;
    pm:has_inlet_stream  pm:IS-04 ;
    pm:has_outlet_stream pm:IS-03 ;
    pm:justified_by pm:DR-M2-003 .

# ============================================================
# SECTION 6 — ABox: MATERIAL STREAMS
# ============================================================

# --- Flue Gas Path ---

pm:S7
    rdf:type pm:MaterialStream ;
    rdfs:label "S7: GT Exhaust Gas"@en ;
    pm:stream_alias   "NETL-S3" ;
    pm:stream_fluid_type "flue_gas" ;
    pm:stream_phase   "vapor" ;
    pm:stream_T       629.0 ;
    pm:stream_P       0.1048 ;
    pm:stream_m_dot   3230636.0 ;
    pm:stream_h       835.81 ;
    pm:feeds          pm:HPSH-001 .

pm:S8
    rdf:type pm:MaterialStream ;
    rdfs:label "S8: FG after HP SH"@en ;
