# ============================================================
# PlantMind GTCC Simulator
# Ontology: HRSG Module (M2) — OWL/Turtle
# Version:  1.0  |  2026-04-03  |  Session 8
# Schema:   PlantMind Ontology v1.1 (same namespace as GT Module v1.2)
# Ref:      HRSG_Module_Math_Model_v1_6_COMPLETE.md
#           NETL DOE/NETL-2010/1397 Ch.5 Case 13
# ============================================================

@prefix pm:   <http://plantmind.io/ontology/gtcc#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# ONTOLOGY HEADER
# ============================================================

<http://plantmind.io/ontology/gtcc/hrsg>
    rdf:type owl:Ontology ;
    owl:versionInfo "1.0" ;
    rdfs:label "PlantMind GTCC — HRSG Module Ontology"@en ;
    rdfs:comment "ABox population for HRSG Module (M2). TBox shared with GT Module namespace."@en ;
    owl:imports <PlantMind_GTCC_GT_Module_v1_2.ttl> .

# ============================================================
# SECTION 1 — TBox: CLASSES
# (Same schema as GT Module v1.2. Included for standalone loading.)
# ============================================================

pm:PlantEntity
    rdf:type owl:Class ;
    rdfs:label "Plant Entity"@en .

pm:KnowledgeEntity
    rdf:type owl:Class ;
    rdfs:label "Knowledge Entity"@en .

pm:Equipment
    rdf:type owl:Class ;
    rdfs:subClassOf pm:PlantEntity ;
    rdfs:label "Equipment"@en .

pm:ProcessModule
    rdf:type owl:Class ;
    rdfs:subClassOf pm:Equipment ;
    rdfs:label "Process Module"@en ;
    rdfs:comment "Top-level process module (M1 GT, M2 HRSG, M3 ST, M4 Condenser)."@en .

pm:ProcessUnit
    rdf:type owl:Class ;
    rdfs:subClassOf pm:Equipment ;
    rdfs:label "Process Unit"@en ;
    rdfs:comment "Individual process unit within a module."@en .

pm:MaterialStream
    rdf:type owl:Class ;
    rdfs:subClassOf pm:PlantEntity ;
    rdfs:label "Material Stream"@en ;
    rdfs:comment "Thermodynamic state vector: {T, P, m_dot, w, h, s}."@en .

pm:Variable
    rdf:type owl:Class ;
    rdfs:subClassOf pm:PlantEntity ;
    rdfs:label "Variable"@en .

pm:ModelParameter
    rdf:type owl:Class ;
    rdfs:subClassOf pm:Variable ;
    rdfs:label "Model Parameter"@en ;
    rdfs:comment "Back-calculated or assumed parameter (Ta layer)."@en .

pm:ComputedScalar
    rdf:type owl:Class ;
    rdfs:subClassOf pm:Variable ;
    rdfs:label "Computed Scalar"@en ;
    rdfs:comment "Unit-local scalar computed by Td layer (Q_dot, W_dot, etc.)."@en .

pm:KPI
    rdf:type owl:Class ;
    rdfs:subClassOf pm:Variable ;
    rdfs:label "KPI"@en ;
    rdfs:comment "Key performance indicator."@en .

pm:CompositionVariable
    rdf:type owl:Class ;
    rdfs:subClassOf pm:Variable ;
    rdfs:label "Composition Variable"@en .

pm:DesignRationale
    rdf:type owl:Class ;
    rdfs:subClassOf pm:KnowledgeEntity ;
    rdfs:label "Design Rationale"@en .

pm:Fault
    rdf:type owl:Class ;
    rdfs:subClassOf pm:KnowledgeEntity ;
    rdfs:label "Fault"@en .

pm:LatentRegime
    rdf:type owl:Class ;
    rdfs:subClassOf pm:KnowledgeEntity ;
    rdfs:label "Latent Regime"@en .

pm:OperatingMode
    rdf:type owl:Class ;
    rdfs:subClassOf pm:KnowledgeEntity ;
    rdfs:label "Operating Mode"@en .

# ============================================================
# SECTION 2 — TBox: OBJECT PROPERTIES
# ============================================================

pm:has_part
    rdf:type owl:ObjectProperty ;
    rdfs:domain pm:ProcessModule ;
    rdfs:range pm:ProcessUnit ;
    owl:inverseOf pm:part_of ;
    rdfs:label "has part"@en .

pm:part_of
    rdf:type owl:ObjectProperty ;
    rdfs:domain pm:ProcessUnit ;
    rdfs:range pm:ProcessModule ;
    owl:inverseOf pm:has_part ;
    rdfs:label "part of"@en .

pm:upstream_of
    rdf:type owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:domain pm:Equipment ;
    rdfs:range pm:Equipment ;
    rdfs:label "upstream of"@en ;
    rdfs:comment "Transitive: if A upstream_of B and B upstream_of C, then A upstream_of C."@en .

pm:has_inlet_stream
    rdf:type owl:ObjectProperty ;
    rdfs:domain pm:Equipment ;
    rdfs:range pm:MaterialStream ;
    rdfs:label "has inlet stream"@en .

pm:has_outlet_stream
    rdf:type owl:ObjectProperty ;
    rdfs:domain pm:Equipment ;
    rdfs:range pm:MaterialStream ;
    rdfs:label "has outlet stream"@en .

pm:feeds
    rdf:type owl:ObjectProperty ;
    rdfs:domain pm:MaterialStream ;
    rdfs:range pm:Equipment ;
    rdfs:label "feeds"@en .

pm:produces
    rdf:type owl:ObjectProperty ;
    rdfs:domain pm:Equipment ;
    rdfs:range pm:MaterialStream ;
    rdfs:label "produces"@en .

pm:has_parameter
    rdf:type owl:ObjectProperty ;
    rdfs:domain pm:Equipment ;
    rdfs:range pm:Variable ;
    rdfs:label "has parameter"@en ;
    rdfs:comment "Renamed from has_state_variable (Session 7). Equipment-local scalar only."@en .

pm:computes_kpi
    rdf:type owl:ObjectProperty ;
    rdfs:domain pm:Equipment ;
    rdfs:range pm:KPI ;
    rdfs:label "computes kpi"@en ;
    rdfs:comment "Direct Equipment→KPI link (added Session 7)."@en .

pm:has_composition
    rdf:type owl:ObjectProperty ;
    rdfs:domain pm:MaterialStream ;
    rdfs:range pm:CompositionVariable ;
    rdfs:label "has composition"@en .

pm:has_heat_duty
    rdf:type owl:ObjectProperty ;
    rdfs:domain pm:Equipment ;
    rdfs:range pm:ComputedScalar ;
    rdfs:label "has heat duty"@en .

pm:has_work_output
    rdf:type owl:ObjectProperty ;
    rdfs:domain pm:Equipment ;
    rdfs:range pm:ComputedScalar ;
    rdfs:label "has work output"@en .

pm:affects
    rdf:type owl:ObjectProperty ;
    rdfs:label "affects"@en ;
    rdfs:comment "Causal relationship for To layer reasoning. Domain/Range open."@en .

pm:justified_by
    rdf:type owl:ObjectProperty ;
    rdfs:domain pm:Equipment ;
    rdfs:range pm:DesignRationale ;
    rdfs:label "justified by"@en .

pm:sets_condition
    rdf:type owl:ObjectProperty ;
    rdfs:domain pm:OperatingMode ;
    rdfs:range pm:Variable ;
    rdfs:label "sets condition"@en .

pm:maps_to
    rdf:type owl:ObjectProperty ;
    rdfs:domain pm:OperatingMode ;
    rdfs:range pm:LatentRegime ;
    rdfs:label "maps to"@en .

pm:has_fault
    rdf:type owl:ObjectProperty ;
    rdfs:domain pm:Equipment ;
    rdfs:range pm:Fault ;
    rdfs:label "has fault"@en .

pm:consumes
    rdf:type owl:ObjectProperty ;
    rdfs:label "consumes"@en .

# ============================================================
# SECTION 3 — TBox: DATA PROPERTIES
# ============================================================

pm:stream_T
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:MaterialStream ;
    rdfs:range xsd:decimal ;
    rdfs:label "stream temperature (°C)"@en .

pm:stream_P
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:MaterialStream ;
    rdfs:range xsd:decimal ;
    rdfs:label "stream pressure (MPa abs)"@en .

pm:stream_m_dot
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:MaterialStream ;
    rdfs:range xsd:decimal ;
    rdfs:label "stream mass flow (kg/hr)"@en .

pm:stream_h
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:MaterialStream ;
    rdfs:range xsd:decimal ;
    rdfs:label "stream specific enthalpy (kJ/kg)"@en .

pm:stream_s
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:MaterialStream ;
    rdfs:range xsd:decimal ;
    rdfs:label "stream specific entropy (kJ/kg/K)"@en .

pm:stream_phase
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:MaterialStream ;
    rdfs:range xsd:string ;
    rdfs:label "stream phase"@en .

pm:stream_fluid_type
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:MaterialStream ;
    rdfs:range xsd:string ;
    rdfs:label "fluid type"@en .

pm:stream_alias
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:MaterialStream ;
    rdfs:range xsd:string ;
    rdfs:label "stream alias"@en ;
    rdfs:comment "Alternative name (e.g. NETL stream ID)."@en .

pm:is_tear_stream
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:MaterialStream ;
    rdfs:range xsd:boolean ;
    rdfs:label "is tear stream"@en .

pm:tear_priority
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:MaterialStream ;
    rdfs:range xsd:string ;
    rdfs:label "tear stream priority"@en .

pm:var_value
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:Variable ;
    rdfs:range xsd:decimal ;
    rdfs:label "variable value"@en .

pm:var_unit
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:Variable ;
    rdfs:range xsd:string ;
    rdfs:label "variable unit"@en .

pm:var_min
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:Variable ;
    rdfs:range xsd:decimal ;
    rdfs:label "variable minimum"@en .

pm:var_max
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:Variable ;
    rdfs:range xsd:decimal ;
    rdfs:label "variable maximum"@en .

pm:var_default
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:Variable ;
    rdfs:range xsd:decimal ;
    rdfs:label "variable default"@en .

pm:layer_tag
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "MHMP layer tag"@en .

pm:kpi_status
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:KPI ;
    rdfs:range xsd:string ;
    rdfs:label "KPI computation status"@en .

pm:tag
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:Equipment ;
    rdfs:range xsd:string ;
    rdfs:label "equipment tag"@en .

pm:unit_id
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:Equipment ;
    rdfs:range xsd:string ;
    rdfs:label "unit ID"@en .

pm:module_id
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:Equipment ;
    rdfs:range xsd:string ;
    rdfs:label "module ID"@en .

pm:vendor_flag
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:Equipment ;
    rdfs:range xsd:boolean ;
    rdfs:label "vendor flag"@en .

pm:calc_order
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:ProcessUnit ;
    rdfs:range xsd:string ;
    rdfs:label "calculation order in gas path"@en .

pm:pattern
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:ProcessUnit ;
    rdfs:range xsd:string ;
    rdfs:label "unit calculation pattern"@en .

pm:dr_selected
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:DesignRationale ;
    rdfs:range xsd:string ;
    rdfs:label "selected option"@en .

pm:dr_rationale
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:DesignRationale ;
    rdfs:range xsd:string ;
    rdfs:label "rationale text"@en .

pm:dr_session
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pm:DesignRationale ;
    rdfs:range xsd:string ;
    rdfs:label "decision session"@en .

# ============================================================
# SECTION 4 — ABox: HRSG MODULE
# ============================================================

# --- Process Module ---

pm:HRSG-M2-001
    rdf:type pm:ProcessModule ;
    rdfs:label "HRSG Module M2"@en ;
    pm:tag        "HRSG-M2" ;
    pm:module_id  "M2" ;
    pm:vendor_flag false ;
    pm:has_part   pm:HPSH-001 ;
    pm:has_part   pm:RH-001 ;
    pm:has_part   pm:HPEV-001 ;
    pm:has_part   pm:IPSH-001 ;
    pm:has_part   pm:HPEC-001 ;
    pm:has_part   pm:IPEV-001 ;
    pm:has_part   pm:IPEC-001 ;
    pm:has_part   pm:LPEV-001 ;
    pm:has_part   pm:LPEC-001 ;
    pm:has_part   pm:IPMX-001 ;
    pm:has_inlet_stream  pm:S7 ;
    pm:has_inlet_stream  pm:IS-02 ;
    pm:has_inlet_stream  pm:IS-06 ;
    pm:has_outlet_stream pm:IS-01 ;
    pm:has_outlet_stream pm:IS-03 ;
    pm:has_outlet_stream pm:IS-05 ;
    pm:has_outlet_stream pm:S16 .

# ============================================================
# SECTION 5 — ABox: PROCESS UNITS (Gas path order: 2-1→2-4→2-2→2-5→2-3→2-6→2-7→2-8→2-9)
# ============================================================

