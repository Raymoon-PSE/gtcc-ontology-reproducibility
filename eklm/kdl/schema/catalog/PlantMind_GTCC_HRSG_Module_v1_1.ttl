# ============================================================
# SECTION 8 — ABox: DESIGN RATIONALES
# ============================================================

pm:DR-M2-001
    rdf:type pm:DesignRationale ;
    rdfs:label "DR-M2-001: HP SH — T_IS01 specification method"@en ;
    pm:dr_selected  "Design specification: T_IS01 = 565.6°C, P_HP = 16.65 MPa. Steam outlet state fully determined." ;
    pm:dr_rationale "NETL Case 13 design point. Both T and P specified at module boundary (IS-01). DOF=0 without iteration." ;
    pm:dr_session   "Session 7, 2026-04-03" .

pm:DR-M2-002
    rdf:type pm:DesignRationale ;
    rdfs:label "DR-M2-002: LP pressure determination (Issue #8)"@en ;
    pm:dr_selected  "P_LP = 0.655 MPa (95 psia). T_sat = ~162°C. IS-05 = saturated vapor, no LP SH in Phase 1." ;
    pm:dr_rationale "NETL Exhibit 5-11 LP feedwater stream at 95 psia. Cross-over pipe at ~73.5 psia (page 6/7). IS-05 mass confirmed by mass balance: LP turbine inlet (1,018,502 lb/hr) = IP exhaust (1,001,509) + IS-05 (16,993). Issue #8 CLOSED." ;
    pm:dr_session   "Session 8, 2026-04-03" .

pm:DR-M2-003
    rdf:type pm:DesignRationale ;
    rdfs:label "DR-M2-003: IS-04 reclassification + Node 2-4M addition"@en ;
    pm:dr_selected  "IS-04 reclassified from module boundary to HRSG internal stream. Node 2-4M (IP Mixing) added. IS-03 = S24 + IS-04 (adiabatic mixing)." ;
    pm:dr_rationale "NETL: m_dot(IS-03) = m_dot(IS-02) + m_dot(IS-04) exactly (in lb/hr). IP steam joins reheated cold reheat inside HRSG. Confirmed by NETL page 4: IP steam mixed with hot reheat, combined admitted to IP turbine." ;
    pm:dr_session   "Session 8, 2026-04-03" .

pm:DR-M2-004
    rdf:type pm:DesignRationale ;
    rdfs:label "DR-M2-004: LP Eco stream map correction"@en ;
    pm:dr_selected  "LP Eco heats total condensate IS-06 (514,240 kg/hr) → S23 → BFP distribution. LP Evap uses separate LP feedwater (Phase 1 parameter)." ;
    pm:dr_rationale "NETL BFP design: single HP BFP with interstage bleeds for IP and LP (page 24). LP BFP: 379 lpm at 95 psia. Original stream map (IS-06 → LP Eco → LP Evap directly) was physically incorrect. LP Evap handles only LP drum feedwater (~7,708 kg/hr steam equivalent)." ;
    pm:dr_session   "Session 8, 2026-04-03" .

pm:DR-M2-005
    rdf:type pm:DesignRationale ;
    rdfs:label "DR-M2-005: Sequential Modular convergence strategy"@en ;
    pm:dr_selected  "SM with Wegstein acceleration. Primary tear: IS-06. Secondary tear: IS-02." ;
    pm:dr_rationale "Phase 1 target is NETL ±5% validation. SM is sufficient; EO is over-engineering. Modular debugging essential. HRSG internal calculation order: gas flow direction (Unit 2-1 → 2-9)." ;
    pm:dr_session   "Session 5, 2026-04-01" .

