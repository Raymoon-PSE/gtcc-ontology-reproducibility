pm:OM-NETL-Case13
    rdf:type pm:OperatingMode ;
    rdfs:label "NETL Case 13 — NGCC 555 MW, 50.2% HHV"@en ;
    pm:sets_condition pm:P_HP ;
    pm:sets_condition pm:P_IP ;
    pm:sets_condition pm:P_LP ;
    pm:sets_condition pm:T_IS01 ;
    pm:sets_condition pm:T_IS04 ;
    pm:sets_condition pm:T_stack .

# ============================================================
# SECTION 10 — ABox: KEY affects CHAINS (To layer)
# ============================================================

# Gas temperature propagation (core HRSG reasoning)
pm:S7    pm:affects pm:S8 .
pm:S8    pm:affects pm:S9 .
pm:S9    pm:affects pm:S10 .
pm:S10   pm:affects pm:S11 .
pm:S11   pm:affects pm:S12 .
pm:S12   pm:affects pm:S13 .
pm:S13   pm:affects pm:S14 .
pm:S14   pm:affects pm:S15 .
pm:S15   pm:affects pm:S16 .

# Steam pressure/temperature propagation
pm:P_HP  pm:affects pm:IS-01 .
pm:P_HP  pm:affects pm:S19 .
pm:P_HP  pm:affects pm:S18 .
pm:P_IP  pm:affects pm:IS-04 .
pm:P_IP  pm:affects pm:S22 .
pm:P_LP  pm:affects pm:IS-05 .

# PTD affects gas outlet and duty
pm:PTD_HP pm:affects pm:Q_hpev .
pm:PTD_IP pm:affects pm:Q_ipev .
pm:PTD_LP pm:affects pm:Q_lpev .
pm:PTD_HP pm:affects pm:S10 .
pm:PTD_IP pm:affects pm:S13 .
pm:PTD_LP pm:affects pm:S15 .

# Stack temperature affects condensate outlet temp
pm:T_stack pm:affects pm:S23 .

# IS-06 (tear stream) affects entire HRSG energy balance
pm:IS-06 pm:affects pm:S23 .
pm:IS-06 pm:affects pm:Q_lpec .

# IS-02 (secondary tear stream) affects Reheater balance
pm:IS-02 pm:affects pm:S24 .
pm:IS-02 pm:affects pm:Q_rh .
pm:IS-02 pm:affects pm:IS-03 .

# Node 2-4M: IS-04 affects IS-03
pm:IS-04 pm:affects pm:IS-03 .
pm:S24   pm:affects pm:IS-03 .

